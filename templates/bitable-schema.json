{
  "app_name": "行业情报库",
  "description": "TRAE 行业情报工作流多维表格结构（机器可读版），字段类型编号与飞书多维表格 API 的 field type 一致：1=多行文本 3=单选 4=多选 5=日期 7=复选框 15=超链接 1001=创建时间",
  "tables": [
    {
      "table_name": "情报沉淀表",
      "fields": [
        { "field_name": "资讯标题", "type": 1, "description": "文章标题" },
        { "field_name": "核心业务标签", "type": 4, "options": ["政策环境", "技术趋势", "竞争格局", "市场动态"], "description": "业务标签，每篇最多 2 个" },
        { "field_name": "信息来源", "type": 1, "description": "来源媒体名称" },
        { "field_name": "发布时间", "type": 5, "description": "文章原始发布时间" },
        { "field_name": "核心摘要提取", "type": 1, "description": "AI 提取的 100 字以内摘要" },
        { "field_name": "研判短评初稿", "type": 1, "description": "AI 生成的初步研判意见" },
        { "field_name": "清洗后正文", "type": 1, "description": "Markdown 格式的干净正文" },
        { "field_name": "原文溯源链接", "type": 15, "description": "原文地址" },
        { "field_name": "入库时间", "type": 1001, "description": "自动记录" },
        { "field_name": "是否已推送", "type": 7, "description": "标记是否已推送" }
      ]
    },
    {
      "table_name": "日报归档表",
      "fields": [
        { "field_name": "报告日期", "type": 5, "description": "日报对应日期" },
        { "field_name": "报告标题", "type": 1, "description": "自动生成" },
        { "field_name": "市场动态与热点", "type": 1, "description": "" },
        { "field_name": "竞品与战略动向", "type": 1, "description": "" },
        { "field_name": "政策与标准规范", "type": 1, "description": "" },
        { "field_name": "技术与前沿观察", "type": 1, "description": "" },
        { "field_name": "分析师要点洞察", "type": 1, "description": "" },
        { "field_name": "报告全文", "type": 1, "description": "Markdown 格式" },
        { "field_name": "复核状态", "type": 3, "options": ["待复核", "已复核", "已发布"], "description": "" }
      ]
    },
    {
      "table_name": "周报归档表",
      "fields": [
        { "field_name": "周次", "type": 1, "description": "如：2026年第33周" },
        { "field_name": "报告标题", "type": 1, "description": "自动生成" },
        { "field_name": "本周数据焦点", "type": 1, "description": "" },
        { "field_name": "出海与全球化动态", "type": 1, "description": "" },
        { "field_name": "竞争格局演变", "type": 1, "description": "" },
        { "field_name": "技术趋势观察", "type": 1, "description": "" },
        { "field_name": "政策环境变化", "type": 1, "description": "" },
        { "field_name": "策略启示与建议", "type": 1, "description": "2-3 条策略建议" },
        { "field_name": "报告全文", "type": 1, "description": "" },
        { "field_name": "复核状态", "type": 3, "options": ["待复核", "已复核", "已发布"], "description": "" }
      ]
    }
  ]
}
